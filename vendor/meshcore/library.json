{
    "name": "MeshCore",
    "version": "1.10.0",
    "description": "Vendored subset of MeshCore (core + BaseChatMesh + ed25519) for the RNS-over-MeshCore tunnel. See PROVENANCE.txt.",
    "license": "MIT",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "build": {
        "srcDir": ".",
        "includeDir": "src",
        "srcFilter": [
            "+<src/*.cpp>",
            "+<src/helpers/*.cpp>",
            "+<lib/ed25519/*.c>"
        ],
        "flags": [
            "-I lib/ed25519"
        ]
    }
}
